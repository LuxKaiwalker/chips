# Only needed when the frontend is published separately from the backend
# (e.g. to GitHub Pages) -- see DEPLOYMENT.md. Leave both unset for the
# plain LAN quick-start mode (./run.sh), where the backend serves this
# frontend itself from the same origin.

# Public origin of the backend, reached through nginx + Cloudflare Tunnel.
# No trailing slash.
VITE_API_BASE=https://chips-api.example.com

# Only set this if publishing to GitHub Pages' default project-site URL
# (https://<user>.github.io/chips/) rather than a custom domain.
VITE_BASE_PATH=/chips/
